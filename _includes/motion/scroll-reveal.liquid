<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Add the class to project cards, publication entries, and news items
    const elementsToReveal = document.querySelectorAll('.card, .bibliography li, .news table tr, .projects .container .row > div');

    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion && elementsToReveal.length > 0) {
      elementsToReveal.forEach((el) => el.classList.add('reveal-on-scroll'));

      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            // Unobserve after revealing to prevent refading on scroll up
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
        observer.observe(el);
      });
    }
  });
</script>
